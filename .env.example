NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/fitbook
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/fitbook_test
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=*
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="FitBook <no-reply@fitbook.dev>"
# Comma-separated Google OAuth client IDs (iOS, Android, web). Optional in development.
GOOGLE_CLIENT_IDS=
# iOS bundle ID used as the audience of Apple identity tokens. Optional in development.
APPLE_BUNDLE_ID=
PENDING_PAYMENT_TTL_MIN=15
LOG_LEVEL=info
